        <mxCell id="c53" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;Logitech C270 webcam&lt;/b&gt; (USB)&lt;br&gt;video: MJPEG 640x480&lt;br&gt;microphone: 16 kHz mono" vertex="1">
