        <mxCell id="c54" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=14;fontStyle=1;arcSize=1;" value="STM32 Nucleo-64 L476RG  (bare-metal C, ST HAL)" vertex="1">
