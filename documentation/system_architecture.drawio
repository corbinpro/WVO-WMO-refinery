          <mxGeometry height="24" width="95" x="2000" y="40" as="geometry" />
        </mxCell>
        <mxCell id="c18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;align=center;verticalAlign=middle;fontSize=10;spacingLeft=0;" value="network service" vertex="1">
          <mxGeometry height="24" width="95" x="2100" y="40" as="geometry" />
        </mxCell>
        <mxCell id="c19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=14;fontStyle=1;arcSize=1;" value="Browsers (on the tailnet)" vertex="1">
          <mxGeometry height="330" width="260" x="20" y="90" as="geometry" />
        </mxCell>
        <mxCell id="c20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;Laptop - Chrome&lt;/b&gt;&lt;br&gt;https://raspberrypi.tail82bc0f.ts.net/&lt;br&gt;&lt;br&gt;index.html&#39;s JavaScript runs HERE: polls /status every 1 s, sends POST /cmd, draws the braille graphs, plays /audio, shows /video/stream" vertex="1">
          <mxGeometry height="125" width="240" x="30" y="135" as="geometry" />
        </mxCell>
        <mxCell id="c21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;iPhone - Safari&lt;/b&gt;&lt;br&gt;same page, same requests&lt;br&gt;&lt;br&gt;status, controls, temperature graphs, 1 fps video, sound (after a tap)" vertex="1">
          <mxGeometry height="125" width="240" x="30" y="275" as="geometry" />
        </mxCell>
        <mxCell id="c22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=14;fontStyle=1;arcSize=1;" value="Tailscale tailnet&lt;br&gt;(WireGuard, encrypted)" vertex="1">
          <mxGeometry height="660" width="190" x="400" y="90" as="geometry" />
        </mxCell>
        <mxCell id="c23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;HTTPS (tailnet only)&lt;/b&gt;&lt;br&gt;raspberrypi.tail82bc0f.ts.net&lt;br&gt;cert issued by Tailscale&lt;br&gt;&lt;br&gt;GET / - the page&lt;br&gt;GET /status - JSON, every 1 s&lt;br&gt;POST /cmd - commands&lt;br&gt;&amp;#160;&amp;#160;(needs X-Refinery: 1)&lt;br&gt;GET /audio - MP3&lt;br&gt;GET /video/stream - MJPEG" vertex="1">
          <mxGeometry height="200" width="170" x="410" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;SSH&lt;/b&gt; (OpenSSH, port 22)&lt;br&gt;only over tailscale0;&lt;br&gt;LAN SSH blocked by UFW" vertex="1">
          <mxGeometry height="90" width="170" x="410" y="370" as="geometry" />
        </mxCell>
        <mxCell id="c25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;Tailnet ACLs&lt;/b&gt;&lt;br&gt;Pi tagged tag:server;&lt;br&gt;it can see only the laptop and the iPhone" vertex="1">
          <mxGeometry height="100" width="170" x="410" y="480" as="geometry" />
        </mxCell>
        <mxCell id="c26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="Each device runs tailscaled; traffic is end-to-end WireGuard, direct over the shop LAN when possible (UDP 41641), relayed otherwise. Nothing is exposed to the LAN or internet." vertex="1">
          <mxGeometry height="130" width="170" x="410" y="600" as="geometry" />
        </mxCell>
        <mxCell id="c27" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=14;fontStyle=1;arcSize=1;" value="Raspberry Pi 2 Model B  (Raspbian 12 bookworm, armv7, host raspberrypi, 100.104.240.3)" vertex="1">
          <mxGeometry height="760" width="1070" x="710" y="90" as="geometry" />
        </mxCell>
        <mxCell id="c28" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;fontStyle=1;arcSize=1;" value="microSD card (files)" vertex="1">
          <mxGeometry height="710" width="290" x="725" y="125" as="geometry" />
        </mxCell>
        <mxCell id="c29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;/home/pi/refinery-ui/&lt;/b&gt;&lt;br&gt;copy of repo pi/refinery-ui; built here:&lt;br&gt;make (gcc 12) -&amp;gt; index_html.h -&amp;gt; binary" vertex="1">
          <mxGeometry height="70" width="270" x="735" y="155" as="geometry" />
        </mxCell>
        <mxCell id="c30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;/usr/local/bin/refinery-ui&lt;/b&gt;&lt;br&gt;compiled C binary (web page inside it)" vertex="1">
          <mxGeometry height="60" width="270" x="735" y="235" as="geometry" />
        </mxCell>
        <mxCell id="c31" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;/etc/systemd/system/&lt;/b&gt;&lt;br&gt;refinery-ui.service, ustreamer.service&lt;br&gt;system.conf.d/watchdog.conf (15 s)" vertex="1">
          <mxGeometry height="70" width="270" x="735" y="305" as="geometry" />
        </mxCell>
        <mxCell id="c32" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;/var/log/journal/&lt;/b&gt;  persistent logs&lt;br&gt;(journald, 50 MB cap): refinery-ui,&lt;br&gt;ustreamer, kernel (USB, HDMI), UFW" vertex="1">
          <mxGeometry height="75" width="270" x="735" y="385" as="geometry" />
        </mxCell>
        <mxCell id="c33" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;/boot/firmware/cmdline.txt&lt;/b&gt;&lt;br&gt;fbcon=rotate:3, consoleblank=0,&lt;br&gt;drm.edid_firmware=..., video=HDMI-A-1:D&lt;br&gt;&lt;b&gt;/lib/firmware/edid/waveshare-4in.bin&lt;/b&gt;&lt;br&gt;/etc/initramfs-tools/hooks/waveshare-edid" vertex="1">
          <mxGeometry height="110" width="270" x="735" y="470" as="geometry" />
        </mxCell>
        <mxCell id="c34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;/etc/ufw/&lt;/b&gt;  deny all incoming except&lt;br&gt;tailscale0 and UDP 41641" vertex="1">
          <mxGeometry height="55" width="270" x="735" y="590" as="geometry" />
        </mxCell>
        <mxCell id="c35" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;/var/lib/tailscale/&lt;/b&gt;  tailscaled state,&lt;br&gt;serve config (/ and /video)" vertex="1">
          <mxGeometry height="55" width="270" x="735" y="655" as="geometry" />
        </mxCell>
        <mxCell id="c36" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;No refinery data is stored on the Pi.&lt;/b&gt;&lt;br&gt;Settings live in STM32 flash; the Pi only keeps the latest status and the temperature history in RAM (lost on restart)." vertex="1">
          <mxGeometry height="105" width="270" x="735" y="720" as="geometry" />
        </mxCell>
        <mxCell id="c37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;fontStyle=1;arcSize=1;" value="Running processes (RAM)" vertex="1">
          <mxGeometry height="710" width="330" x="1135" y="125" as="geometry" />
        </mxCell>
        <mxCell id="c38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;tailscaled + tailscale serve&lt;/b&gt; (HTTPS :443)&lt;br&gt;/ -&amp;gt; 127.0.0.1:8000 (refinery-ui)&lt;br&gt;/video -&amp;gt; 127.0.0.1:8080 (ustreamer)" vertex="1">
          <mxGeometry height="70" width="310" x="1145" y="155" as="geometry" />
        </mxCell>
        <mxCell id="c39" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;refinery-ui&lt;/b&gt; (C, systemd, user pi, owns tty1)&lt;br&gt;one single-threaded poll() loop:&lt;br&gt;&amp;#8226; &lt;b&gt;link.c&lt;/b&gt; - /dev/serial0: sends $C commands,&lt;br&gt;&amp;#160;&amp;#160;parses $S status + $A acks&lt;br&gt;&amp;#8226; &lt;b&gt;ui.c + fb.c&lt;/b&gt; - draws the btop-style screen&lt;br&gt;&amp;#160;&amp;#160;(800x480, rotated 270) into /dev/fb0&lt;br&gt;&amp;#8226; &lt;b&gt;input.c&lt;/b&gt; - number pad keys (evdev)&lt;br&gt;&amp;#8226; &lt;b&gt;web.c&lt;/b&gt; - HTTP on 127.0.0.1:8000; fans the&lt;br&gt;&amp;#160;&amp;#160;ffmpeg MP3 out to every /audio listener&lt;br&gt;&amp;#8226; &lt;b&gt;cam.c&lt;/b&gt; - CAMERA view: JPEG decode (libjpeg)&lt;br&gt;&lt;br&gt;RAM only: latest status, temperature history,&lt;br&gt;command acks. Screen sleeps after 10 min&lt;br&gt;without a key press; any key wakes it." vertex="1">
          <mxGeometry height="295" width="310" x="1145" y="270" as="geometry" />
        </mxCell>
        <mxCell id="c40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;ustreamer&lt;/b&gt; (C, systemd) 127.0.0.1:8080&lt;br&gt;/dev/video0 MJPEG 640x480 @ 1 fps&lt;br&gt;-&amp;gt; /stream (MJPEG), /snapshot (JPEG)" vertex="1">
          <mxGeometry height="70" width="310" x="1145" y="575" as="geometry" />
        </mxCell>
        <mxCell id="c41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;ffmpeg&lt;/b&gt; - started by refinery-ui only while&lt;br&gt;someone listens to /audio: mic -&amp;gt; MP3 64 kbps" vertex="1">
          <mxGeometry height="60" width="310" x="1145" y="655" as="geometry" />
        </mxCell>
        <mxCell id="c42" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;systemd + journald&lt;/b&gt;&lt;br&gt;restarts services, feeds the hardware watchdog" vertex="1">
          <mxGeometry height="55" width="310" x="1145" y="725" as="geometry" />
        </mxCell>
        <mxCell id="c43" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;fontStyle=1;arcSize=1;" value="Device nodes&lt;br&gt;(Linux drivers)" vertex="1">
          <mxGeometry height="710" width="160" x="1605" y="125" as="geometry" />
        </mxCell>
        <mxCell id="c44" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="Pi GPIO header:&lt;br&gt;pin 8 TXD, pin 10 RXD,&lt;br&gt;pin 6 GND" vertex="1">
          <mxGeometry height="65" width="140" x="1615" y="165" as="geometry" />
        </mxCell>
        <mxCell id="c45" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;/dev/serial0&lt;/b&gt; -&amp;gt; ttyAMA0&lt;br&gt;UART 115200 8N1, 3.3 V&lt;br&gt;3 wires to STM32 USART1:&lt;br&gt;TX, RX, GND" vertex="1">
          <mxGeometry height="85" width="140" x="1615" y="270" as="geometry" />
        </mxCell>
        <mxCell id="c46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;/dev/fb0&lt;/b&gt;&lt;br&gt;vc4 KMS fbdev&lt;br&gt;480x800 RGB565&lt;br&gt;HDMI-A-1 62 Hz" vertex="1">
          <mxGeometry height="85" width="140" x="1615" y="365" as="geometry" />
        </mxCell>
        <mxCell id="c47" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;/dev/input/event*&lt;/b&gt;&lt;br&gt;number pad (grabbed&lt;br&gt;by refinery-ui)" vertex="1">
          <mxGeometry height="85" width="140" x="1615" y="460" as="geometry" />
        </mxCell>
        <mxCell id="c48" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;/dev/video0&lt;/b&gt;&lt;br&gt;(uvcvideo)&lt;br&gt;&lt;b&gt;ALSA card 2&lt;/b&gt;&lt;br&gt;(USB audio)&lt;br&gt;= Logitech C270" vertex="1">
          <mxGeometry height="100" width="140" x="1615" y="575" as="geometry" />
        </mxCell>
        <mxCell id="c49" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;wlan0&lt;/b&gt; Realtek USB Wi-Fi&lt;br&gt;SSID WOT-Shop&lt;br&gt;LAN 192.168.0.90 (DHCP)&lt;br&gt;power save off&lt;br&gt;&lt;br&gt;carries ALL Pi network traffic. Pi 2 has one USB 2.0 bus shared by Wi-Fi, camera, keypad." vertex="1">
          <mxGeometry height="145" width="140" x="1615" y="685" as="geometry" />
        </mxCell>
