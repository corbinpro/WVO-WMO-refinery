        </mxCell>
        <mxCell id="c55" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;USART1&lt;/b&gt; - Pi link&lt;br&gt;PB6 TX (D10), PB7 RX (CN7)&lt;br&gt;115200 8N1, 3.3 V" vertex="1">
          <mxGeometry height="75" width="210" x="1955" y="125" as="geometry" />
        </mxCell>
        <mxCell id="c56" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;USART2&lt;/b&gt; PA2 / PA3&lt;br&gt;optional debug: mirror of every&lt;br&gt;line sent, over the Nucleo USB" vertex="1">
          <mxGeometry height="75" width="210" x="2175" y="125" as="geometry" />
        </mxCell>
        <mxCell id="c57" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;Main loop&lt;/b&gt;: every 100 ms read ADC -&amp;gt; ctl_step() -&amp;gt; drive GPIO.&lt;br&gt;Commands are applied immediately, then acked. Status once a second&lt;br&gt;(and soon after any change)." vertex="1">
          <mxGeometry height="65" width="430" x="1955" y="210" as="geometry" />
        </mxCell>
        <mxCell id="c58" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;RAM: ctl_t&lt;/b&gt; - tank states + timers, drain phase, centrifuge, overrides,&lt;br&gt;heater loops, fire latch. Lost on reset: tanks restart IDLE, outputs OFF" vertex="1">
          <mxGeometry height="50" width="430" x="1955" y="285" as="geometry" />
        </mxCell>
        <mxCell id="c59" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;Flash page 0x080FF800&lt;/b&gt; (last 2 KB, bank 2) - settings record:&lt;br&gt;temperature presets, timer durations, nozzle preset" vertex="1">
          <mxGeometry height="50" width="430" x="1955" y="345" as="geometry" />
        </mxCell>
        <mxCell id="c60" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;Flash: refinery_fw.elf&lt;/b&gt; (main.c, control.c, proto.c, HAL)&lt;br&gt;All control logic lives here; the rig keeps running if the Pi stops." vertex="1">
          <mxGeometry height="55" width="430" x="1955" y="405" as="geometry" />
        </mxCell>
        <mxCell id="c61" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;Protocol&lt;/b&gt; (spec: firmware Core/Inc/proto.h), lines $...*HH:&lt;br&gt;Pi -&amp;gt; STM32  $C,&amp;lt;id&amp;gt;,START | CANCEL | TEMP | TIME | NOZ | OVR | FIREACK | PING&lt;br&gt;STM32 -&amp;gt; Pi  $S,... temps, levels, outputs, tank states + timers (1 Hz)&lt;br&gt;STM32 -&amp;gt; Pi  $A,&amp;lt;id&amp;gt;,OK  or  $A,&amp;lt;id&amp;gt;,ERR,&amp;lt;reason&amp;gt;" vertex="1">
          <mxGeometry height="85" width="430" x="1955" y="470" as="geometry" />
        </mxCell>
        <mxCell id="c62" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;Flame inputs&lt;/b&gt; PB1 / PB2 / PC5 (pull-up, active-LOW) - DISABLED&lt;br&gt;in firmware (FLAME_SENSORS_ENABLED 0) until the sensors are wired" vertex="1">
          <mxGeometry height="45" width="430" x="1955" y="565" as="geometry" />
        </mxCell>
        <mxCell id="c63" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;ADC1&lt;/b&gt; (12-bit, 16x average)&lt;br&gt;A0 PA0 tank 1 temperature&lt;br&gt;A1 PA1 tank 2 temperature&lt;br&gt;A2 PA4 nozzle temperature&lt;br&gt;A3 PB0 / A4 PC1 tank levels" vertex="1">
          <mxGeometry height="100" width="210" x="1955" y="620" as="geometry" />
        </mxCell>
        <mxCell id="c64" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;GPIO outputs&lt;/b&gt; (active-HIGH)&lt;br&gt;D2 PA10 / D3 PB3 tank valves&lt;br&gt;D4 PB5 / D5 PB4 tank heaters&lt;br&gt;D6 PB10 nozzle htr, D9 PC7 motor&lt;br&gt;D7 PA8 / D8 PA9 extinguisher" vertex="1">
          <mxGeometry height="100" width="210" x="2175" y="620" as="geometry" />
        </mxCell>
        <mxCell id="c65" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=14;fontStyle=1;arcSize=1;" value="Refinery rig (field wiring)" vertex="1">
          <mxGeometry height="245" width="460" x="1940" y="755" as="geometry" />
