        <mxCell id="c66" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;Sensors&lt;/b&gt;&lt;br&gt;3x NTC3950 10k probes&lt;br&gt;(10k divider to GND):&lt;br&gt;tank 1, tank 2, nozzle&lt;br&gt;&lt;br&gt;2x marine reed level senders&lt;br&gt;240-33 ohm (100 ohm divider)&lt;br&gt;&lt;br&gt;3x LM393 flame sensors&lt;br&gt;(not wired yet)" vertex="1">
          <mxGeometry height="200" width="210" x="1955" y="790" as="geometry" />
