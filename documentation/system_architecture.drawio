<mxfile host="Electron">
  <diagram name="System architecture" id="arch">
    <mxGraphModel dx="1569" dy="987" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c11" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;b&gt;&lt;font style=&#39;font-size:22px&#39;&gt;WVO/WMO Refinery - System Architecture&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Where every program and file lives and runs, and what data moves where. Updated 2026-10-23.&lt;br&gt;&lt;b&gt;Black solid&lt;/b&gt; = runtime data &amp;#160;&amp;#160; &lt;b&gt;&lt;font color=&#39;#b85450&#39;&gt;Red dashed&lt;/font&gt;&lt;/b&gt; = build / deploy &amp;#160;&amp;#160; &lt;b&gt;&lt;font color=&#39;#808080&#39;&gt;Grey dotted&lt;/font&gt;&lt;/b&gt; = optional debug / not wired yet" vertex="1">
          <mxGeometry height="70" width="900" x="20" y="8" as="geometry" />
        </mxCell>
        <mxCell id="c12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;arcSize=1;" value="Legend" vertex="1">
