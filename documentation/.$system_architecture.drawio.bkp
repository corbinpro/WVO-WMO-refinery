<mxfile host="refinery-gen">
<diagram name="System architecture" id="arch">
<mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1100" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="c11" value="&lt;b&gt;&lt;font style='font-size:22px'&gt;WVO/WMO Refinery - System Architecture&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Where every program and file lives and runs, and what data moves where. Updated 2026-10-23.&lt;br&gt;&lt;b&gt;Black solid&lt;/b&gt; = runtime data &amp;#160;&amp;#160; &lt;b&gt;&lt;font color='#b85450'&gt;Red dashed&lt;/font&gt;&lt;/b&gt; = build / deploy &amp;#160;&amp;#160; &lt;b&gt;&lt;font color='#808080'&gt;Grey dotted&lt;/font&gt;&lt;/b&gt; = optional debug / not wired yet" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="900" height="70" as="geometry"/></mxCell>
<mxCell id="c12" value="Legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontStyle=1;arcSize=1;" vertex="1" parent="1"><mxGeometry x="1940" y="6" width="460" height="66" as="geometry"/></mxCell>
<mxCell id="c13" value="C program / source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;align=center;verticalAlign=middle;fontSize=10;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="2000" y="10" width="95" height="24" as="geometry"/></mxCell>
<mxCell id="c14" value="HTML / JavaScript" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;align=center;verticalAlign=middle;fontSize=10;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="2100" y="10" width="95" height="24" as="geometry"/></mxCell>
<mxCell id="c15" value="config / data file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;align=center;verticalAlign=middle;fontSize=10;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="2200" y="10" width="95" height="24" as="geometry"/></mxCell>
<mxCell id="c16" value="logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;align=center;verticalAlign=middle;fontSize=10;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="2300" y="10" width="95" height="24" as="geometry"/></mxCell>
<mxCell id="c17" value="hardware / device" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;align=center;verticalAlign=middle;fontSize=10;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="2000" y="40" width="95" height="24" as="geometry"/></mxCell>
<mxCell id="c18" value="network service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;align=center;verticalAlign=middle;fontSize=10;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="2100" y="40" width="95" height="24" as="geometry"/></mxCell>
<mxCell id="c19" value="Browsers (on the tailnet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=14;fontStyle=1;arcSize=1;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="260" height="330" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;b&gt;Laptop - Chrome&lt;/b&gt;&lt;br&gt;https://raspberrypi.tail82bc0f.ts.net/&lt;br&gt;&lt;br&gt;index.html's JavaScript runs HERE: polls /status every 1 s, sends POST /cmd, draws the braille graphs, plays /audio, shows /video/stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="30" y="135" width="240" height="125" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;b&gt;iPhone - Safari&lt;/b&gt;&lt;br&gt;same page, same requests&lt;br&gt;&lt;br&gt;status, controls, temperature graphs, 1 fps video, sound (after a tap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="30" y="275" width="240" height="125" as="geometry"/></mxCell>
<mxCell id="c22" value="Tailscale tailnet&lt;br&gt;(WireGuard, encrypted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=14;fontStyle=1;arcSize=1;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="190" height="660" as="geometry"/></mxCell>
<mxCell id="c23" value="&lt;b&gt;HTTPS (tailnet only)&lt;/b&gt;&lt;br&gt;raspberrypi.tail82bc0f.ts.net&lt;br&gt;cert issued by Tailscale&lt;br&gt;&lt;br&gt;GET / - the page&lt;br&gt;GET /status - JSON, every 1 s&lt;br&gt;POST /cmd - commands&lt;br&gt;&amp;#160;&amp;#160;(needs X-Refinery: 1)&lt;br&gt;GET /audio - MP3&lt;br&gt;GET /video/stream - MJPEG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="410" y="150" width="170" height="200" as="geometry"/></mxCell>
<mxCell id="c24" value="&lt;b&gt;SSH&lt;/b&gt; (OpenSSH, port 22)&lt;br&gt;only over tailscale0;&lt;br&gt;LAN SSH blocked by UFW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="410" y="370" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="c25" value="&lt;b&gt;Tailnet ACLs&lt;/b&gt;&lt;br&gt;Pi tagged tag:server;&lt;br&gt;it can see only the laptop and the iPhone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="410" y="480" width="170" height="100" as="geometry"/></mxCell>
<mxCell id="c26" value="Each device runs tailscaled; traffic is end-to-end WireGuard, direct over the shop LAN when possible (UDP 41641), relayed otherwise. Nothing is exposed to the LAN or internet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="410" y="600" width="170" height="130" as="geometry"/></mxCell>
<mxCell id="c27" value="Raspberry Pi 2 Model B  (Raspbian 12 bookworm, armv7, host raspberrypi, 100.104.240.3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=14;fontStyle=1;arcSize=1;" vertex="1" parent="1"><mxGeometry x="710" y="90" width="1070" height="760" as="geometry"/></mxCell>
<mxCell id="c28" value="microSD card (files)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;fontStyle=1;arcSize=1;" vertex="1" parent="1"><mxGeometry x="725" y="125" width="290" height="710" as="geometry"/></mxCell>
<mxCell id="c29" value="&lt;b&gt;/home/pi/refinery-ui/&lt;/b&gt;&lt;br&gt;copy of repo pi/refinery-ui; built here:&lt;br&gt;make (gcc 12) -&amp;gt; index_html.h -&amp;gt; binary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="735" y="155" width="270" height="70" as="geometry"/></mxCell>
<mxCell id="c30" value="&lt;b&gt;/usr/local/bin/refinery-ui&lt;/b&gt;&lt;br&gt;compiled C binary (web page inside it)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="735" y="235" width="270" height="60" as="geometry"/></mxCell>
<mxCell id="c31" value="&lt;b&gt;/etc/systemd/system/&lt;/b&gt;&lt;br&gt;refinery-ui.service, ustreamer.service&lt;br&gt;system.conf.d/watchdog.conf (15 s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="735" y="305" width="270" height="70" as="geometry"/></mxCell>
<mxCell id="c32" value="&lt;b&gt;/var/log/journal/&lt;/b&gt;  persistent logs&lt;br&gt;(journald, 50 MB cap): refinery-ui,&lt;br&gt;ustreamer, kernel (USB, HDMI), UFW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="735" y="385" width="270" height="75" as="geometry"/></mxCell>
<mxCell id="c33" value="&lt;b&gt;/boot/firmware/cmdline.txt&lt;/b&gt;&lt;br&gt;fbcon=rotate:3, consoleblank=0,&lt;br&gt;drm.edid_firmware=..., video=HDMI-A-1:D&lt;br&gt;&lt;b&gt;/lib/firmware/edid/waveshare-4in.bin&lt;/b&gt;&lt;br&gt;/etc/initramfs-tools/hooks/waveshare-edid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="735" y="470" width="270" height="110" as="geometry"/></mxCell>
<mxCell id="c34" value="&lt;b&gt;/etc/ufw/&lt;/b&gt;  deny all incoming except&lt;br&gt;tailscale0 and UDP 41641" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="735" y="590" width="270" height="55" as="geometry"/></mxCell>
<mxCell id="c35" value="&lt;b&gt;/var/lib/tailscale/&lt;/b&gt;  tailscaled state,&lt;br&gt;serve config (/ and /video)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="735" y="655" width="270" height="55" as="geometry"/></mxCell>
<mxCell id="c36" value="&lt;b&gt;No refinery data is stored on the Pi.&lt;/b&gt;&lt;br&gt;Settings live in STM32 flash; the Pi only keeps the latest status and the temperature history in RAM (lost on restart)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="735" y="720" width="270" height="105" as="geometry"/></mxCell>
<mxCell id="c37" value="Running processes (RAM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;fontStyle=1;arcSize=1;" vertex="1" parent="1"><mxGeometry x="1135" y="125" width="330" height="710" as="geometry"/></mxCell>
<mxCell id="c38" value="&lt;b&gt;tailscaled + tailscale serve&lt;/b&gt; (HTTPS :443)&lt;br&gt;/ -&amp;gt; 127.0.0.1:8000 (refinery-ui)&lt;br&gt;/video -&amp;gt; 127.0.0.1:8080 (ustreamer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1145" y="155" width="310" height="70" as="geometry"/></mxCell>
<mxCell id="c39" value="&lt;b&gt;refinery-ui&lt;/b&gt; (C, systemd, user pi, owns tty1)&lt;br&gt;one single-threaded poll() loop:&lt;br&gt;&amp;#8226; &lt;b&gt;link.c&lt;/b&gt; - /dev/serial0: sends $C commands,&lt;br&gt;&amp;#160;&amp;#160;parses $S status + $A acks&lt;br&gt;&amp;#8226; &lt;b&gt;ui.c + fb.c&lt;/b&gt; - draws the btop-style screen&lt;br&gt;&amp;#160;&amp;#160;(800x480, rotated 270) into /dev/fb0&lt;br&gt;&amp;#8226; &lt;b&gt;input.c&lt;/b&gt; - number pad keys (evdev)&lt;br&gt;&amp;#8226; &lt;b&gt;web.c&lt;/b&gt; - HTTP on 127.0.0.1:8000; fans the&lt;br&gt;&amp;#160;&amp;#160;ffmpeg MP3 out to every /audio listener&lt;br&gt;&amp;#8226; &lt;b&gt;cam.c&lt;/b&gt; - CAMERA view: JPEG decode (libjpeg)&lt;br&gt;&lt;br&gt;RAM only: latest status, temperature history,&lt;br&gt;command acks. Screen sleeps after 10 min&lt;br&gt;without a key press; any key wakes it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1145" y="265" width="310" height="300" as="geometry"/></mxCell>
<mxCell id="c40" value="&lt;b&gt;ustreamer&lt;/b&gt; (C, systemd) 127.0.0.1:8080&lt;br&gt;/dev/video0 MJPEG 640x480 @ 1 fps&lt;br&gt;-&amp;gt; /stream (MJPEG), /snapshot (JPEG)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1145" y="575" width="310" height="70" as="geometry"/></mxCell>
<mxCell id="c41" value="&lt;b&gt;ffmpeg&lt;/b&gt; - started by refinery-ui only while&lt;br&gt;someone listens to /audio: mic -&amp;gt; MP3 64 kbps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1145" y="655" width="310" height="60" as="geometry"/></mxCell>
<mxCell id="c42" value="&lt;b&gt;systemd + journald&lt;/b&gt;&lt;br&gt;restarts services, feeds the hardware watchdog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1145" y="725" width="310" height="55" as="geometry"/></mxCell>
<mxCell id="c43" value="Device nodes&lt;br&gt;(Linux drivers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;fontStyle=1;arcSize=1;" vertex="1" parent="1"><mxGeometry x="1605" y="125" width="160" height="710" as="geometry"/></mxCell>
<mxCell id="c44" value="Pi GPIO header:&lt;br&gt;pin 8 TXD, pin 10 RXD,&lt;br&gt;pin 6 GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1615" y="165" width="140" height="65" as="geometry"/></mxCell>
<mxCell id="c45" value="&lt;b&gt;/dev/serial0&lt;/b&gt; -&amp;gt; ttyAMA0&lt;br&gt;UART 115200 8N1, 3.3 V&lt;br&gt;3 wires to STM32 USART1:&lt;br&gt;TX, RX, GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1615" y="270" width="140" height="85" as="geometry"/></mxCell>
<mxCell id="c46" value="&lt;b&gt;/dev/fb0&lt;/b&gt;&lt;br&gt;vc4 KMS fbdev&lt;br&gt;480x800 RGB565&lt;br&gt;HDMI-A-1 62 Hz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1615" y="365" width="140" height="85" as="geometry"/></mxCell>
<mxCell id="c47" value="&lt;b&gt;/dev/input/event*&lt;/b&gt;&lt;br&gt;number pad (grabbed&lt;br&gt;by refinery-ui)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1615" y="460" width="140" height="85" as="geometry"/></mxCell>
<mxCell id="c48" value="&lt;b&gt;/dev/video0&lt;/b&gt;&lt;br&gt;(uvcvideo)&lt;br&gt;&lt;b&gt;ALSA card 2&lt;/b&gt;&lt;br&gt;(USB audio)&lt;br&gt;= Logitech C270" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1615" y="575" width="140" height="100" as="geometry"/></mxCell>
<mxCell id="c49" value="&lt;b&gt;wlan0&lt;/b&gt; Realtek USB Wi-Fi&lt;br&gt;SSID WOT-Shop&lt;br&gt;LAN 192.168.0.90 (DHCP)&lt;br&gt;power save off&lt;br&gt;&lt;br&gt;carries ALL Pi network traffic. Pi 2 has one USB 2.0 bus shared by Wi-Fi, camera, keypad." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1615" y="685" width="140" height="145" as="geometry"/></mxCell>
<mxCell id="c50" value="USB / HDMI peripherals on the Pi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=14;fontStyle=1;arcSize=1;" vertex="1" parent="1"><mxGeometry x="710" y="870" width="1070" height="120" as="geometry"/></mxCell>
<mxCell id="c51" value='&lt;b&gt;Waveshare 4" HDMI LCD&lt;/b&gt;&lt;br&gt;480x800 portrait, mounted landscape&lt;br&gt;HDMI only, own 5 V supply (no touch)' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1135" y="905" width="200" height="75" as="geometry"/></mxCell>
<mxCell id="c52" value="&lt;b&gt;SIGMACHIP USB number pad&lt;/b&gt;&lt;br&gt;arrows / 8-2-4-6 move, Enter / 5 select,&lt;br&gt;NumLock on = type timer digits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1350" y="905" width="200" height="75" as="geometry"/></mxCell>
<mxCell id="c53" value="&lt;b&gt;Logitech C270 webcam&lt;/b&gt; (USB)&lt;br&gt;video: MJPEG 640x480&lt;br&gt;microphone: 16 kHz mono" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1565" y="905" width="200" height="75" as="geometry"/></mxCell>
<mxCell id="c54" value="STM32 Nucleo-64 L476RG  (bare-metal C, ST HAL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=14;fontStyle=1;arcSize=1;" vertex="1" parent="1"><mxGeometry x="1940" y="90" width="460" height="645" as="geometry"/></mxCell>
<mxCell id="c55" value="&lt;b&gt;USART1&lt;/b&gt; - Pi link&lt;br&gt;PB6 TX (D10), PB7 RX (CN7)&lt;br&gt;115200 8N1, 3.3 V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1955" y="125" width="210" height="75" as="geometry"/></mxCell>
<mxCell id="c56" value="&lt;b&gt;USART2&lt;/b&gt; PA2 / PA3&lt;br&gt;optional debug: mirror of every&lt;br&gt;line sent, over the Nucleo USB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="2175" y="125" width="210" height="75" as="geometry"/></mxCell>
<mxCell id="c57" value="&lt;b&gt;Main loop&lt;/b&gt;: every 100 ms read ADC -&amp;gt; ctl_step() -&amp;gt; drive GPIO.&lt;br&gt;Commands are applied immediately, then acked. Status once a second&lt;br&gt;(and soon after any change)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1955" y="210" width="430" height="65" as="geometry"/></mxCell>
<mxCell id="c58" value="&lt;b&gt;RAM: ctl_t&lt;/b&gt; - tank states + timers, drain phase, centrifuge, overrides,&lt;br&gt;heater loops, fire latch. Lost on reset: tanks restart IDLE, outputs OFF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1955" y="285" width="430" height="50" as="geometry"/></mxCell>
<mxCell id="c59" value="&lt;b&gt;Flash page 0x080FF800&lt;/b&gt; (last 2 KB, bank 2) - settings record:&lt;br&gt;temperature presets, timer durations, nozzle preset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1955" y="345" width="430" height="50" as="geometry"/></mxCell>
<mxCell id="c60" value="&lt;b&gt;Flash: refinery_fw.elf&lt;/b&gt; (main.c, control.c, proto.c, HAL)&lt;br&gt;All control logic lives here; the rig keeps running if the Pi stops." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1955" y="405" width="430" height="55" as="geometry"/></mxCell>
<mxCell id="c61" value="&lt;b&gt;Protocol&lt;/b&gt; (spec: firmware Core/Inc/proto.h), lines $...*HH:&lt;br&gt;Pi -&amp;gt; STM32  $C,&amp;lt;id&amp;gt;,START | CANCEL | TEMP | TIME | NOZ | OVR | FIREACK | PING&lt;br&gt;STM32 -&amp;gt; Pi  $S,... temps, levels, outputs, tank states + timers (1 Hz)&lt;br&gt;STM32 -&amp;gt; Pi  $A,&amp;lt;id&amp;gt;,OK  or  $A,&amp;lt;id&amp;gt;,ERR,&amp;lt;reason&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1955" y="470" width="430" height="85" as="geometry"/></mxCell>
<mxCell id="c62" value="&lt;b&gt;Flame inputs&lt;/b&gt; PB1 / PB2 / PC5 (pull-up, active-LOW) - DISABLED&lt;br&gt;in firmware (FLAME_SENSORS_ENABLED 0) until the sensors are wired" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1955" y="565" width="430" height="45" as="geometry"/></mxCell>
<mxCell id="c63" value="&lt;b&gt;ADC1&lt;/b&gt; (12-bit, 16x average)&lt;br&gt;A0 PA0 tank 1 temperature&lt;br&gt;A1 PA1 tank 2 temperature&lt;br&gt;A2 PA4 nozzle temperature&lt;br&gt;A3 PB0 / A4 PC1 tank levels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1955" y="620" width="210" height="100" as="geometry"/></mxCell>
<mxCell id="c64" value="&lt;b&gt;GPIO outputs&lt;/b&gt; (active-HIGH)&lt;br&gt;D2 PA10 / D3 PB3 tank valves&lt;br&gt;D4 PB5 / D5 PB4 tank heaters&lt;br&gt;D6 PB10 nozzle htr, D9 PC7 motor&lt;br&gt;D7 PA8 / D8 PA9 extinguisher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="2175" y="620" width="210" height="100" as="geometry"/></mxCell>
<mxCell id="c65" value="Refinery rig (field wiring)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=14;fontStyle=1;arcSize=1;" vertex="1" parent="1"><mxGeometry x="1940" y="755" width="460" height="245" as="geometry"/></mxCell>
<mxCell id="c66" value="&lt;b&gt;Sensors&lt;/b&gt;&lt;br&gt;3x NTC3950 10k probes&lt;br&gt;(10k divider to GND):&lt;br&gt;tank 1, tank 2, nozzle&lt;br&gt;&lt;br&gt;2x marine reed level senders&lt;br&gt;240-33 ohm (100 ohm divider)&lt;br&gt;&lt;br&gt;3x LM393 flame sensors&lt;br&gt;(not wired yet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1955" y="790" width="210" height="200" as="geometry"/></mxCell>
<mxCell id="c67" value="&lt;b&gt;Actuators&lt;/b&gt;&lt;br&gt;4x motorized ball valves 12 V&lt;br&gt;(relay per tank, on = open,&lt;br&gt;20 s travel)&lt;br&gt;&lt;br&gt;2x tank block heaters + nozzle&lt;br&gt;heater 120 V AC via SSR-40DA&lt;br&gt;&lt;br&gt;centrifuge motor (1/3 hp) via&lt;br&gt;Adafruit power relay&lt;br&gt;&lt;br&gt;extinguisher actuator via&lt;br&gt;2 relays (extend / retract)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="2175" y="790" width="210" height="200" as="geometry"/></mxCell>
<mxCell id="c68" value="make + install" style="strokeColor=#b85450;strokeWidth=2;dashed=1;dashPattern=8 4;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
