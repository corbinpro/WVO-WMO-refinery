<mxfile host="refinery-gen">
<diagram name="Data flow" id="flow">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2210" pageHeight="760" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="c11" value="&lt;b&gt;&lt;font style='font-size:22px'&gt;WVO/WMO Refinery - Data Flow&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Commands travel left to right; information streams travel right to left. Each block lists the processing done on that hardware. Updated 2026-10-23." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="60" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;&lt;font color='#1f6fd1'&gt;&amp;#9473;&amp;#9473;&amp;#9658; Commands&lt;/font&gt;&lt;/b&gt; (operator -&amp;gt; equipment)&lt;br&gt;&lt;b&gt;&lt;font color='#2e9e4f'&gt;&amp;#9668;&amp;#9473;&amp;#9473; Information&lt;/font&gt;&lt;/b&gt; (equipment -&amp;gt; operator; dashed = audio/video)" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1500" y="14" width="600" height="50" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;Browsers&lt;/font&gt;&lt;/b&gt; (on the tailnet)&lt;br&gt;Laptop - Chrome &amp;#160;&amp;#183;&amp;#160; iPhone - Safari&lt;br&gt;https://raspberrypi.tail82bc0f.ts.net/&lt;br&gt;&lt;br&gt;&lt;b&gt;Processing (JavaScript in the page):&lt;/b&gt;&lt;br&gt;&amp;#8226; polls status every 1 s, renders tanks,&lt;br&gt;&amp;#160;&amp;#160;meters and braille temperature graphs&lt;br&gt;&amp;#8226; turns clicks / keys into commands&lt;br&gt;&amp;#8226; plays the MJPEG video and MP3 audio&lt;br&gt;&amp;#8226; cannot clear a fire fault (local only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="320" height="260" as="geometry"/></mxCell>
<mxCell id="c14" value="&lt;b&gt;&lt;font style='font-size:14px'&gt;Screen&lt;/font&gt;&lt;/b&gt; - Waveshare 4&quot; HDMI LCD&lt;br&gt;&lt;b&gt;Processing:&lt;/b&gt; displays the 800x480 UI frames&lt;br&gt;(btop look); powered down when the UI sleeps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="320" height="95" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;b&gt;&lt;font style='font-size:14px'&gt;Number pad&lt;/font&gt;&lt;/b&gt; - USB&lt;br&gt;&lt;b&gt;Processing:&lt;/b&gt; key scan -&amp;gt; USB HID codes&lt;br&gt;(arrows/8-2-4-6 move, Enter/5 select, digits)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="320" height="95" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;&lt;font style='font-size:14px'&gt;Webcam + mic&lt;/font&gt;&lt;/b&gt; - Logitech C270, USB&lt;br&gt;&lt;b&gt;Processing:&lt;/b&gt; compresses video to MJPEG 640x480&lt;br&gt;on the camera; samples audio at 16 kHz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="320" height="95" as="geometry"/></mxCell>
<mxCell id="c17" value="&lt;i&gt;Local I/O at the machine&lt;/i&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="705" width="320" height="20" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;&lt;font style='font-size:16px'&gt;Raspberry Pi 2&lt;/font&gt;&lt;/b&gt; (Linux)&lt;br&gt;user interface + network gateway; stores no refinery data&lt;br&gt;&lt;br&gt;&lt;b&gt;Processing:&lt;/b&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;tailscale serve&lt;/b&gt; - HTTPS, tailnet-only access&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;refinery-ui&lt;/b&gt; (C):&lt;br&gt;&amp;#160;&amp;#160;- checks web requests (Host, X-Refinery header,&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;no FIREACK from the web)&lt;br&gt;&amp;#160;&amp;#160;- turns key presses and web requests into&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;$C commands; queues, retries, matches acks&lt;br&gt;&amp;#160;&amp;#160;- parses $S status, keeps temperature history&lt;br&gt;&amp;#160;&amp;#160;- draws the screen, serves the page + JSON&lt;br&gt;&amp;#160;&amp;#160;- timer entry (HH:MM), dropdowns, focus&lt;br&gt;&amp;#160;&amp;#160;- screen sleep after 10 min, wake on key&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;ustreamer&lt;/b&gt; - camera -&amp;gt; MJPEG stream, 1 fps&lt;br&gt;&amp;#8226; &lt;b&gt;ffmpeg&lt;/b&gt; (only while someone listens) -&lt;br&gt;&amp;#160;&amp;#160;mic -&amp;gt; MP3 64 kbps&lt;br&gt;&lt;br&gt;Logs: journald (/var/log/journal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="590" y="90" width="380" height="605" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;b&gt;&lt;font style='font-size:16px'&gt;STM32 Nucleo-L476RG&lt;/font&gt;&lt;/b&gt; (bare-metal C)&lt;br&gt;the controller: all decisions are made here,&lt;br&gt;and it keeps running if the Pi stops&lt;br&gt;&lt;br&gt;&lt;b&gt;Processing&lt;/b&gt; (every 100 ms):&lt;br&gt;&amp;#8226; ADC -&amp;gt; temperature (&amp;#176;F, Beta equation)&lt;br&gt;&amp;#160;&amp;#160;and tank level (%)&lt;br&gt;&amp;#8226; settle timers per tank (wall clock)&lt;br&gt;&amp;#8226; drain sequencing: centrifuge spin-up, valve&lt;br&gt;&amp;#160;&amp;#160;travel 20 s, empty at &amp;#8804;5 % for 10 s, 5 min&lt;br&gt;&amp;#160;&amp;#160;run-out, hand-off to the other tank, tank 1 first&lt;br&gt;&amp;#8226; heater thermostats &amp;#177;5 &amp;#176;F, 220 &amp;#176;F hard cutoff,&lt;br&gt;&amp;#160;&amp;#160;out-of-tolerance flags&lt;br&gt;&amp;#8226; manual overrides, per-tank cancel&lt;br&gt;&amp;#8226; fire: debounce -&amp;gt; cut heaters, motor, valves -&amp;gt;&lt;br&gt;&amp;#160;&amp;#160;extinguisher extend / retract -&amp;gt; latch&lt;br&gt;&amp;#160;&amp;#160;(flame sensors disabled until wired)&lt;br&gt;&amp;#8226; validates commands, answers OK / ERR&lt;br&gt;&amp;#8226; saves settings to flash (presets, timers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1220" y="90" width="380" height="605" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;b&gt;&lt;font style='font-size:16px'&gt;Refinery hardware I/O&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Inputs&lt;/b&gt;&lt;br&gt;&amp;#8226; 3 temperature probes (NTC 10k):&lt;br&gt;&amp;#160;&amp;#160;tank 1, tank 2, nozzle&lt;br&gt;&amp;#8226; 2 tank level senders (reed / float)&lt;br&gt;&amp;#8226; 3 flame sensors (not wired yet)&lt;br&gt;&lt;br&gt;&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;&amp;#8226; tank valves - 4 motorized ball valves, 12 V&lt;br&gt;&amp;#8226; 2 tank heaters + nozzle heater, 120 V&lt;br&gt;&amp;#8226; centrifuge motor, 120 V&lt;br&gt;&amp;#8226; fire extinguisher actuator&lt;br&gt;&lt;br&gt;&lt;b&gt;Processing&lt;/b&gt;&lt;br&gt;&amp;#8226; voltage dividers turn sensor resistance&lt;br&gt;&amp;#160;&amp;#160;into 0-3.3 V&lt;br&gt;&amp;#8226; relays / SSRs switch 12 V and 120 V loads&lt;br&gt;&amp;#160;&amp;#160;from 3.3 V logic&lt;br&gt;&amp;#8226; valves close on their own when unpowered&lt;br&gt;&amp;#8226; the oil itself: settle + heat in the tanks,&lt;br&gt;&amp;#160;&amp;#160;heat at the nozzle, centrifuge separates&lt;br&gt;&amp;#160;&amp;#160;water and solids" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1850" y="90" width="340" height="605" as="geometry"/></mxCell>
<mxCell id="c21" value="HTTPS  POST /cmd&lt;br&gt;START &amp;#183; CANCEL &amp;#183; TEMP &amp;#183; TIME&lt;br&gt;NOZ &amp;#183; OVR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1f6fd1;strokeWidth=3;fontSize=11;fontColor=#1f6fd1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;exitX=1;exitY=0.1923;exitDx=0;exitDy=0;entryX=0;entryY=0.0826;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c22" value="HTTPS  GET /status (JSON, every 1 s)&lt;br&gt;tank states, temps, levels,&lt;br&gt;history, command results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2e9e4f;strokeWidth=3;fontSize=11;fontColor=#2e9e4f;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;exitX=0;exitY=0.2314;exitDx=0;exitDy=0;entryX=1;entryY=0.5385;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c23" value="video (MJPEG 1 fps)&lt;br&gt;audio (MP3)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2e9e4f;strokeWidth=3;fontSize=11;fontColor=#2e9e4f;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;exitX=0;exitY=0.3636;exitDx=0;exitDy=0;entryX=1;entryY=0.8462;entryDx=0;entryDy=0;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="c18" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c24" value="HDMI frames&lt;br&gt;(UI, camera view)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2e9e4f;strokeWidth=3;fontSize=11;fontColor=#2e9e4f;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;exitX=0;exitY=0.5570;exitDx=0;exitDy=0;entryX=1;entryY=0.4947;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c25" value="key presses (USB HID)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1f6fd1;strokeWidth=3;fontSize=11;fontColor=#1f6fd1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;exitX=1;exitY=0.4947;exitDx=0;exitDy=0;entryX=0;entryY=0.7388;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c26" value="MJPEG video + PCM audio (USB)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2e9e4f;strokeWidth=3;fontSize=11;fontColor=#2e9e4f;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;exitX=1;exitY=0.4947;exitDx=0;exitDy=0;entryX=0;entryY=0.9207;entryDx=0;entryDy=0;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c27" value="UART  $C commands&lt;br&gt;START &amp;#183; CANCEL &amp;#183; TEMP &amp;#183; TIME&lt;br&gt;NOZ &amp;#183; OVR &amp;#183; FIREACK &amp;#183; PING" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1f6fd1;strokeWidth=3;fontSize=11;fontColor=#1f6fd1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;exitX=1;exitY=0.1818;exitDx=0;exitDy=0;entryX=0;entryY=0.1818;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c28" value="UART  $S status every 1 s&lt;br&gt;temps, levels, outputs, tank states,&lt;br&gt;timers, fire state, warnings&lt;br&gt;+ $A acks (OK / ERR reason)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2e9e4f;strokeWidth=3;fontSize=11;fontColor=#2e9e4f;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;exitX=0;exitY=0.5620;exitDx=0;exitDy=0;entryX=1;entryY=0.5620;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c29" value="GPIO 3.3 V on / off&lt;br&gt;valves &amp;#183; heaters &amp;#183; centrifuge&lt;br&gt;extinguisher extend / retract" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1f6fd1;strokeWidth=3;fontSize=11;fontColor=#1f6fd1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;exitX=1;exitY=0.1818;exitDx=0;exitDy=0;entryX=0;entryY=0.1818;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c30" value="analog 0-3.3 V&lt;br&gt;temperatures, levels&lt;br&gt;flame (digital, disabled)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2e9e4f;strokeWidth=3;fontSize=11;fontColor=#2e9e4f;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;exitX=0;exitY=0.5620;exitDx=0;exitDy=0;entryX=1;entryY=0.5620;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>
